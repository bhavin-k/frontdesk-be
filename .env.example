# Inject real connection URLs and secrets at runtime. Do not commit .env.
RECRUITMENT_ENVIRONMENT=development
RECRUITMENT_DATABASE_URL=
RECRUITMENT_AUTH_DATABASE_URL=
RECRUITMENT_WORKER_DATABASE_URL=
RECRUITMENT_DISPATCHER_DATABASE_URL=
RECRUITMENT_MIGRATION_DATABASE_URL=

# Supply generated passwords of at least 24 characters for the initial Alembic upgrade.
RECRUITMENT_DB_API_PASSWORD=
RECRUITMENT_DB_AUTH_PASSWORD=
RECRUITMENT_DB_WORKER_PASSWORD=
RECRUITMENT_DB_DISPATCHER_PASSWORD=

RECRUITMENT_PROVIDER_MODE=real
# New CV jobs use full-text scoring. Set rag to route new work back to RAG.
RECRUITMENT_SCORING_STRATEGY=
RECRUITMENT_CV_TOKEN_CEILING=20000
# This request budget applies to experience checks in both scoring paths.
RECRUITMENT_EXPERIENCE_REQUEST_TOKENS=8000
RECRUITMENT_EXPERIENCE_OUTPUT_TOKENS=3072
# Set the request budget to fit both the model context and your provider account limits.
RECRUITMENT_FULL_TEXT_REQUEST_TOKENS=32768
RECRUITMENT_FULL_TEXT_OUTPUT_TOKENS=3072
# LLM provider name records provenance; the endpoint and API format select the wire protocol.
RECRUITMENT_LLM_PROVIDER=openai
RECRUITMENT_LLM_BASE_URL=https://api.openai.com/v1
RECRUITMENT_LLM_API_KEY=
# auto = Responses at the official OpenAI endpoint, Chat Completions elsewhere.
RECRUITMENT_LLM_API_FORMAT=auto
# Chat Completions also accepts json_object or text, with local schema validation.
RECRUITMENT_LLM_OUTPUT_MODE=json_schema
RECRUITMENT_LLM_TIMEOUT_SECONDS=45
# Existing RECRUITMENT_OPENAI_API_KEY remains a fallback at the official OpenAI endpoint.
RECRUITMENT_PROFILE_MODEL=gpt-6-luna
RECRUITMENT_GRADER_MODEL=gpt-6.1-terra
RECRUITMENT_EMBEDDING_MODEL=text-embedding-3-large
RECRUITMENT_EMBEDDING_DIMENSIONS=1536
RECRUITMENT_HNSW_EF_SEARCH=40
RECRUITMENT_AWS_REGION=ap-south-1
RECRUITMENT_CLAMAV_HOST=127.0.0.1
RECRUITMENT_CLAMAV_PORT=3310
RECRUITMENT_AUTO_DELETE_ENABLED=false

# Independent OpenAI-compatible embedding service. Custom endpoints require an explicit key.
RECRUITMENT_EMBEDDING_PROVIDER=openai
RECRUITMENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
RECRUITMENT_EMBEDDING_API_KEY=
# Set false for models that reject the dimensions parameter. Output must still be 1536 values.
RECRUITMENT_EMBEDDING_SEND_DIMENSIONS=true
RECRUITMENT_EMBEDDING_REVISION=1
RECRUITMENT_EMBEDDING_BATCH_SIZE=128
RECRUITMENT_EMBEDDING_MAX_BATCH_TOKENS=64000
RECRUITMENT_EMBEDDING_TIMEOUT_SECONDS=30
RECRUITMENT_EMBEDDING_MAX_PARALLEL_CALLS=4
RECRUITMENT_CHUNK_SIZE_TOKENS=400
RECRUITMENT_CHUNK_OVERLAP_TOKENS=64
RECRUITMENT_RETRIEVAL_MODE=hybrid
RECRUITMENT_RETRIEVAL_CANDIDATES_PER_METHOD=12
RECRUITMENT_RETRIEVAL_TOP_K=5
RECRUITMENT_RETRIEVAL_NEIGHBOR_WINDOW=1
RECRUITMENT_RETRIEVAL_CONTEXT_TOKENS=3000
RECRUITMENT_RETRIEVAL_RRF_K=60

# Intake. Local launcher defaults to fake; production requires real.
RECRUITMENT_MAILBOX_PROVIDER_MODE=real
# Comma-separated allowlist. Add imap for development/testing; production rejects it.
# Remove imap, restart API AND worker, and refresh the dashboard to stop/hide IMAP.
RECRUITMENT_ENABLED_MAILBOX_METHODS=gmail_oauth,microsoft_oauth
RECRUITMENT_IMAP_POLL_SECONDS=60
RECRUITMENT_IMAP_TIMEOUT_SECONDS=10
RECRUITMENT_PUBLIC_APP_URL=http://localhost:3100
# For one public app URL, use the same HTTPS origin for APP and WEBHOOK;
# run ngrok against frontend port 3100. Keep the Gmail audience's full webhook path.
RECRUITMENT_PUBLIC_WEBHOOK_URL=
# Independent JSON key ring {key_id: base64-encoded 32-byte key}; keep outside source control.
RECRUITMENT_CREDENTIAL_KEYS=
RECRUITMENT_CREDENTIAL_ACTIVE_KEY=1
RECRUITMENT_GMAIL_CLIENT_ID=
RECRUITMENT_GMAIL_CLIENT_SECRET=
RECRUITMENT_GMAIL_PUBSUB_TOPIC=
RECRUITMENT_GMAIL_PUSH_AUDIENCE=
RECRUITMENT_GMAIL_PUSH_SERVICE_ACCOUNT=
RECRUITMENT_MICROSOFT_CLIENT_ID=
RECRUITMENT_MICROSOFT_CLIENT_SECRET=
RECRUITMENT_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
RECRUITMENT_DOCUMENT_CONVERTER_URL=http://127.0.0.1:8300
RECRUITMENT_DOCUMENT_CONVERSION_TIMEOUT_SECONDS=60
