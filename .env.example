# Copy to backend/.env and fill in your credentials. Keep .env out of Git.

# ============================================================
# 1. MAILBOX OAUTH - GMAIL AND MICROSOFT
# ============================================================
# Google dashboard sign-in uses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# in frontend/.env.local.
RECRUITMENT_GMAIL_CLIENT_ID=
RECRUITMENT_GMAIL_CLIENT_SECRET=

# Fill these only if connecting an Outlook mailbox.
RECRUITMENT_MICROSOFT_CLIENT_ID=
RECRUITMENT_MICROSOFT_CLIENT_SECRET=
RECRUITMENT_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common

# ============================================================
# 2. EMAIL INTAKE
# ============================================================
RECRUITMENT_MAILBOX_PROVIDER_MODE=real
# IMAP is for development and testing. Remove it for production.
RECRUITMENT_ENABLED_MAILBOX_METHODS=imap,gmail_oauth,microsoft_oauth
RECRUITMENT_IMAP_POLL_SECONDS=60
RECRUITMENT_IMAP_TIMEOUT_SECONDS=10

# ============================================================
# 3. PUBLIC APP URL AND GMAIL PUSH
# ============================================================
# Point ngrok at frontend port 3100. Keep the full path in the push audience.
RECRUITMENT_PUBLIC_APP_URL=https://multifoliate-hilaria-uncynical.ngrok-free.dev
RECRUITMENT_PUBLIC_WEBHOOK_URL=https://multifoliate-hilaria-uncynical.ngrok-free.dev
RECRUITMENT_GMAIL_PUSH_AUDIENCE=https://multifoliate-hilaria-uncynical.ngrok-free.dev/api/v1/mailbox-webhooks/gmail
RECRUITMENT_GMAIL_PUBSUB_TOPIC=projects/recruitment-email-integration/topics/recruitment-cv-intake
RECRUITMENT_GMAIL_PUSH_SERVICE_ACCOUNT=recruitment-gmail-push@recruitment-email-integration.iam.gserviceaccount.com

# ============================================================
# 4. MAILBOX CREDENTIAL ENCRYPTION
# ============================================================
# Reuse the existing key ring and active key ID for connected mailboxes.
# Format: JSON object mapping key IDs to base64-encoded 32-byte keys.
RECRUITMENT_CREDENTIAL_ACTIVE_KEY=1
RECRUITMENT_CREDENTIAL_KEYS=

# ============================================================
# 5. APP AND POSTGRESQL
# ============================================================
RECRUITMENT_ENVIRONMENT=development
RECRUITMENT_AUTO_DELETE_ENABLED=false

# Leave these blank with node scripts/dev.mjs; it supplies local database settings.
RECRUITMENT_DATABASE_URL=
RECRUITMENT_AUTH_DATABASE_URL=
RECRUITMENT_WORKER_DATABASE_URL=
RECRUITMENT_DISPATCHER_DATABASE_URL=

# For manual migrations, export the migration URL in your shell.
# For a manual fresh database, also export role passwords of at least 24 characters.
RECRUITMENT_MIGRATION_DATABASE_URL=
RECRUITMENT_DB_API_PASSWORD=
RECRUITMENT_DB_AUTH_PASSWORD=
RECRUITMENT_DB_WORKER_PASSWORD=
RECRUITMENT_DB_DISPATCHER_PASSWORD=

# ============================================================
# 6. CV EXTRACTION - PADDLEOCR, CLAMAV AND DOCUMENT CONVERSION
# ============================================================
RECRUITMENT_PROVIDER_MODE=real
# The model path is relative to the backend working directory.
RECRUITMENT_OCR_MODELS_DIR=.local/paddleocr
RECRUITMENT_CLAMAV_HOST=127.0.0.1
RECRUITMENT_CLAMAV_PORT=3310
RECRUITMENT_DOCUMENT_CONVERTER_URL=http://127.0.0.1:8300
RECRUITMENT_DOCUMENT_CONVERSION_TIMEOUT_SECONDS=60

# ============================================================
# 7. LLM - CV PARSER AND JOB DESCRIPTION MATCHER
# ============================================================
RECRUITMENT_LLM_PROVIDER=anthropic
RECRUITMENT_LLM_BASE_URL=https://api.anthropic.com/v1/
RECRUITMENT_LLM_API_KEY=
# Auto selects Chat Completions for Anthropic. Text mode still validates JSON locally.
RECRUITMENT_LLM_API_FORMAT=auto
RECRUITMENT_LLM_OUTPUT_MODE=text
RECRUITMENT_LLM_TIMEOUT_SECONDS=45
RECRUITMENT_PROFILE_MODEL=claude-haiku-5-5
# Enable for Chat Completions providers that accept thinking: {type: disabled}.
RECRUITMENT_PROFILE_CHAT_DISABLE_THINKING=true
RECRUITMENT_GRADER_MODEL=claude-haiku-5-5
RECRUITMENT_GRADER_CHAT_DISABLE_THINKING=true
RECRUITMENT_CV_TOKEN_CEILING=20000
RECRUITMENT_LLM_REQUEST_TOKENS=32768
RECRUITMENT_LLM_OUTPUT_TOKENS=3072

# ============================================================
# 8. EMAIL SCREENING PILOT
# ============================================================
# Leave the tenant ID blank to disable screening email.
# Connect Gmail with IMAP and confirm its Inbox in Integrations for this tenant.
RECRUITMENT_SCREENING_TEST_TENANT_ID=
RECRUITMENT_SCREENING_AVAILABILITY_FILE=.local/screening-availability.json
RECRUITMENT_SCREENING_EMAIL_LIMIT_PER_HOUR=30
